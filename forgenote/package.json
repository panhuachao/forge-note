{
  "name": "forgenote",
  "version": "1.0.0",
  "description": "锦囊笔记 ForgeNote - 本地开源AI知识库笔记",
  "main": "dist/main/index.js",
  "author": "Pan HuaChao",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && dotenv -e .env -- electron-builder --mac --universal",
    "package:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "rebuild:native": "electron-rebuild -f -o better-sqlite3",
    "postinstall": "electron-rebuild -f -o better-sqlite3 && node scripts/fix-electron-quarantine.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "nanoid": "^3.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.4",
    "@electron/rebuild": "^4.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "electron": "^31.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "cn.com.tinyapp.forgenote.app",
    "productName": "锦囊笔记",
    "icon": "resources/icons/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "panhuachao",
        "repo": "forge-note",
        "private": true
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "ForgeNote-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    }
  }
}
